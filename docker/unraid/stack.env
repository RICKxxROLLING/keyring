# Paste into Unraid: Docker -> Compose -> your stack -> Edit .env
#
# Compose Manager writes this next to the stack's docker-compose.yml, which is
# exactly where Compose looks for it. Fill in the four marked CHANGE ME values;
# everything else is already set for a LAN-first Unraid deployment.
#
# This file holds secrets once you fill it in. It lives on the flash drive and
# is not in git. Do not paste it back into a chat, an issue, or a gist.

# ------------------------------------------------------------------ core ---
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# CHANGE ME. Start with your server's LAN address so you can confirm the app
# works before adding Cloudflare as a second variable. Switch to the https://
# tunnel hostname when you uncomment cloudflared — it must match the public URL
# EXACTLY, scheme included: it drives Secure cookies, HSTS, and the WebSocket
# origin check, and a mismatch presents as login loops or dead realtime sync,
# not a clear error.
#
# ┌─ THE PORT APPEARS TWICE IN THIS FILE ────────────────────────────────────┐
# │ The port here and KEYRING_PORT further down must be THE SAME NUMBER.       │
# │                                                                          │
# │ KEYRING_PORT is what Docker actually publishes. The port in APP_ORIGIN is  │
# │ only what the app believes its own URL is. Changing one without the      │
# │ other is silent: you browse the port you edited here and nothing         │
# │ answers, because Docker is still publishing the other one.               │
# └──────────────────────────────────────────────────────────────────────────┘
APP_ORIGIN=http://192.168.1.10:8088

APP_VERSION=1.0.0
APP_TIMEZONE=America/New_York

# ------------------------------------------------------------ data paths ---
# Inside the container everything lives under /data; the stack bind-mounts
# KEYRING_DATA_DIR there. You should not need to change these four.
DATA_DIR=/data
# DB_PATH=/data/keyring.db
# UPLOAD_DIR=/data/uploads
# BACKUP_DIR=/data/backups

# --------------------------------------------------------------- secrets ---

# CHANGE ME. 32+ random characters. Generate one on the server with:
#   openssl rand -base64 48
# Rotating it later signs everyone out immediately.
SESSION_SECRET=change-me-to-at-least-32-random-characters

# CHANGE ME. The ONLY key to every backup this app writes. There is no escrow
# and no recovery: lose it and every existing archive is permanently
# unreadable. Put it in a password manager OFF this box before you continue.
BACKUP_PASSPHRASE=change-me-to-a-long-random-passphrase

# Leave unset. First boot generates one, logs it once, and writes it to
# /data/setup-token.txt (mode 0600) for you to use at /setup.
# SETUP_TOKEN=

# ---------------------------------------------------------------- tuning ---
SESSION_TTL_HOURS=336
INVITE_TTL_HOURS=72
UPLOAD_MAX_BYTES=26214400
RATE_LIMIT_MAX=600
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
BACKUP_AT=03:15
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=info

# ------------------------------------------------------------- proxy/TLS ---
# Believe X-Forwarded-For only from private/loopback peers — which is what the
# cloudflared sidecar is on the Docker network. Do NOT set this to `true`
# (trusts the whole chain, so a client's own header becomes req.ip and both
# rate limiters are defeated by rotating one header), and do NOT set a bare
# number (this Fastify version fails closed on hop counts, attributing every
# request to the sidecar). See docs/OPERATIONS.md.
TRUST_PROXY=loopback,uniquelocal

# Derived from APP_ORIGIN (true when it starts with https://). While you are on
# plain http on the LAN this is correctly false; it flips on by itself when you
# move APP_ORIGIN to the tunnel hostname.
# SECURE_COOKIES=true

# --------------------------------------------------------- Unraid / paths ---
# 99:100 = nobody:users, Unraid's default. The entrypoint chowns /data to this
# and runs node as it — never as root.
PUID=99
PGID=100

# The host port Docker actually publishes. 8088 rather than 8080, which
# collides with many Unraid containers.
#
# MUST MATCH the port in APP_ORIGIN above. If you change one, change both —
# nothing warns you, and the symptom is "the page never loads" while the
# container looks perfectly healthy. Confirm what is really published with:
#   docker inspect keyring --format '{{json .HostConfig.PortBindings}}'
KEYRING_PORT=8088

# CHANGE ME only if you cloned somewhere else. Must NOT be inside the src
# directory — upgrading replaces src wholesale.
KEYRING_DATA_DIR=/mnt/user/appdata/keyring/data

# ---------------------------------------------------- cloudflared sidecar ---
# CHANGE ME when you uncomment the cloudflared service. Cloudflare Zero Trust
# -> Networks -> Tunnels -> your tunnel -> install a connector -> copy token.
# Only the cloudflared container ever reads this.
# TUNNEL_TOKEN=
