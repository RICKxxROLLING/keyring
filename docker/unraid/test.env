# Paste into Unraid: Docker -> Compose -> keyring-test -> Edit .env
#
# The test server's own settings. Nothing here is shared with production:
# generate fresh secrets for it, never copy production's .env across. A test
# copy holding production's SESSION_SECRET would accept production's session
# cookies, and one holding its BACKUP_PASSPHRASE could open its backups.
#
# Generate the two secrets on the server, straight into this file, so they are
# never displayed or pasted anywhere:
#   P=/boot/config/plugins/compose.manager/projects/keyring-test
#   sed -i "s|^SESSION_SECRET=.*|SESSION_SECRET=$(openssl rand -base64 48 | tr -d '\n/+=')|" $P/.env
#   sed -i "s|^BACKUP_PASSPHRASE=.*|BACKUP_PASSPHRASE=$(openssl rand -base64 48 | tr -d '\n/+=')|" $P/.env

# Production mode on purpose: the point is to behave exactly like the real one.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# CHANGE ME to the server's LAN address. The port must match KEYRING_PORT.
# Plain http is correct here — it is LAN only, and SECURE_COOKIES follows it.
APP_ORIGIN=http://192.168.1.10:8090
APP_TIMEZONE=America/New_York

DATA_DIR=/data

# CHANGE ME — generate on the server, see the top of this file.
SESSION_SECRET=change-me-to-at-least-32-random-characters
# CHANGE ME — a throwaway: it only ever locks demo-data backups. Nightly
# backups stay on so the backup path is exercised on real hardware too.
BACKUP_PASSPHRASE=change-me-to-a-long-random-passphrase

SESSION_TTL_HOURS=336
INVITE_TTL_HOURS=72
UPLOAD_MAX_BYTES=26214400
RATE_LIMIT_MAX=600
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
BACKUP_AT=03:45
# Demo data is cheap to recreate; keep only a few days of it.
BACKUP_RETENTION_DAYS=3
LOG_LEVEL=info
TRUST_PROXY=loopback,uniquelocal

PUID=99
PGID=100

KEYRING_PORT=8090
KEYRING_DATA_DIR=/mnt/user/appdata/keyring-test/data

# Optional: pin a specific build instead of following :test.
# KEYRING_TEST_TAG=sha-<full commit sha>
