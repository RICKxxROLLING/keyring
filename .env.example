# Stoop environment configuration.
#
# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# the values marked REQUIRED. Everything else has a sane default and can be
# left alone until you have a reason to change it.
#
# SECURITY: `.env` holds secrets (SESSION_SECRET, BACKUP_PASSPHRASE,
# TUNNEL_TOKEN). It is gitignored. Never commit it. Store a copy of
# BACKUP_PASSPHRASE in a password manager OFF this box — see docs/OPERATIONS.md.

# ---------------------------------------------------------------- core ---

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# The public HTTPS URL people actually use to reach Stoop (your Cloudflare
# Tunnel hostname). This drives Secure cookies, HSTS, the CSP
# upgrade-insecure-requests directive, and the WebSocket Origin check.
# REQUIRED for a real deployment.
APP_ORIGIN=https://stoop.example.com

APP_VERSION=1.0.0

# IANA timezone for business dates (due dates, lease dates) and for when the
# daily jobs (backup, PM generation, rent roll) fire. Also set the container's
# TZ to the same value (docker-compose.yml already does this from this var).
APP_TIMEZONE=America/New_York

# ---------------------------------------------------------- data / paths ---
# All persistent state lives under one bind-mounted directory. Inside the
# container this is always /data (see docker-compose.yml's volumes: entry);
# you should not need to change DATA_DIR/DB_PATH/UPLOAD_DIR/BACKUP_DIR
# themselves when running via Docker.

DATA_DIR=/data
# DB_PATH=/data/stoop.db
# UPLOAD_DIR=/data/uploads
# Point BACKUP_DIR at a second, physically separate location (e.g. a
# different Unraid array share, or a mounted network volume) if you want
# backups to survive the loss of the /data volume itself.
# BACKUP_DIR=/data/backups

# --------------------------------------------------------------- secrets ---

# REQUIRED in production. At least 32 random characters. Rotating this logs
# every session out immediately (see docs/OPERATIONS.md for how and why you
# might want to). Generate one with: openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Leave unset on first boot: Stoop generates one, logs it once, and writes it
# to $DATA_DIR/setup-token.txt (mode 0600) for you to use at /setup. It is
# consumed and made unusable the moment the first (owner) account is created.
# Set it explicitly only if you want to control the value yourself.
# SETUP_TOKEN=

# REQUIRED for backups to run at all. This is the ONLY key to every backup
# archive Stoop ever writes. There is no escrow and no recovery path — losing
# it means every existing backup becomes permanently unreadable. Generate a
# strong passphrase and save it in a password manager OFF this box the moment
# you set it here. See docs/OPERATIONS.md and docs/RESTORE.md.
BACKUP_PASSPHRASE=change-me-to-a-long-random-passphrase

# --------------------------------------------------------------- tuning ---

SESSION_TTL_HOURS=336
INVITE_TTL_HOURS=72
UPLOAD_MAX_BYTES=26214400
RATE_LIMIT_MAX=600
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# HH:mm, in APP_TIMEZONE, for the nightly encrypted backup job.
BACKUP_AT=03:15
# Archives older than this are deleted, EXCEPT the newest 3 are always kept
# regardless of age.
BACKUP_RETENTION_DAYS=14

LOG_LEVEL=info

# ------------------------------------------------------------ proxy/TLS ---

# true behind cloudflared (the default and normal case for this deployment).
# Set to a number instead if you stack another reverse proxy in front of
# cloudflared, to set the exact trusted hop count. Getting this wrong means
# every request appears to come from the tunnel's own address: rate limiting
# and auth lockout become global (one bad actor can lock out all three
# users), and audit-log IPs become useless. /api/ops/info and the request
# logs show the resolved client IP so a misconfiguration is visible fast.
TRUST_PROXY=true

# Derived automatically from APP_ORIGIN (true when it starts with https://).
# Override only for local HTTPS testing.
# SECURE_COOKIES=true

# ------------------------------------------------------- Unraid / Docker ---

# Unraid convention: the entrypoint chowns /data to this user/group and then
# runs the node process as it (never as root). Never read by node itself.
# Unraid's usual defaults are 99 (nobody) / 100 (users) — check
# Settings > User Utilities in the Unraid UI if unsure.
PUID=99
PGID=100

# Host port to publish for LAN access (optional — the tunnel needs no
# published port at all). See docker-compose.yml.
STOOP_PORT=8080

# Host path for the bind-mounted /data volume. Point this at your Unraid
# appdata share, e.g. /mnt/user/appdata/stoop.
STOOP_DATA_DIR=./data

# ---------------------------------------------------- cloudflared sidecar ---

# REQUIRED to bring the tunnel up. From the Cloudflare Zero Trust dashboard:
# Networks > Tunnels > (create/select a tunnel) > install a connector > copy
# the token. This value never reaches the `stoop` container — only
# `cloudflared` reads it (see docker-compose.yml).
TUNNEL_TOKEN=change-me-to-your-cloudflare-tunnel-token

# ------------------------------------------------------------------- dev ---

# Frontend-only (T4's MSW mock switch). Leave unset in every real deployment.
# VITE_USE_MOCKS=
